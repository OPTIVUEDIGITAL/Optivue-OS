{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "optivue-growth-os",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "growth.optivuedigital.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./production"
  }
}
