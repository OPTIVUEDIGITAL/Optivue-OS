{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "optivue-growth-os",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "npm ci && npm run build:production"
  },
  "assets": {
    "directory": "./production",
    "html_handling": "drop-trailing-slash"
  }
}
